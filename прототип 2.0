import random

# --- SIMULATION CONFIGURATION ---
TOTAL_PLAYERS = 10000
SUSPICIOUS_PLAYERS_COUNT = 1500
PRO_PLAYERS_COUNT = 3
JUDGES_COUNT = 500

class Player:
    def __init__(self, player_id, role):
        self.id = player_id
        self.role = role  # Options: 'clean', 'cheater', 'pro'
        self.status = "Active"  # Options: 'Active', 'Shadow_Flagged', 'Banned'
        self.honeypot_triggered = False
        self.shadow_matches_left = 0
        self.lucky_shot_trigger = False  # False alarms on clean players

class Judge:
    def __init__(self, judge_id):
        self.id = judge_id
        # Base Glicko-2 rating distribution
        self.rating = random.randint(1300, 2100) 
        self.lazy_voter = random.random() < 0.05  # 5% probability of a low-effort spam clicker
        self.test_cases_passed = 0
        self.test_cases_failed = 0

    @property
    def rank(self):
        if self.rating < 1600:
            return "Trainee"
        elif self.rating < 1950:
            return "Judge"
        else:
            return "Senior Judge"

    @property
    def vote_weight(self):
        if self.rank == "Trainee":
            return 1
        elif self.rank == "Judge":
            return 3
        else: # Senior Judge
            return 9

    def evaluate_case(self, player, is_test_case=False):
        """Simulates judge decision-making based on rating, accuracy, and player type."""
        if self.lazy_voter:
            # Lazy voters randomly select a verdict to click through quickly
            return random.choice(["Guilty", "Innocent"])

        # Base accuracy scales with Glicko-2 rating (ranging from 65% to 98%)
        accuracy = 0.70 + (self.rating - 1300) / 800 * 0.28
        accuracy = min(0.98, max(0.65, accuracy))

        roll = random.random()
        
        if player.role == "cheater":
            # Correct verdict is Guilty
            return "Guilty" if roll <= accuracy else "Innocent"
        elif player.role == "clean":
            # Correct verdict is Innocent
            return "Innocent" if roll <= accuracy else "Guilty"
        elif player.role == "pro":
            # Professional players display inhuman mechanics, making them hard to distinguish
            # Standard accuracy drops significantly when evaluating clean high-tier pros
            pro_detection_accuracy = accuracy * 0.60
            return "Innocent" if roll <= pro_detection_accuracy else "Guilty"


# ==========================================
# SYSTEM INITIALIZATION
# ==========================================
print("[VAC Live + Overwatch 2.0] Initializing Simulation...")

players = []
# Register the 3 pro players
for i in range(PRO_PLAYERS_COUNT):
    players.append(Player(f"PRO_{i+1}", "pro"))
# Register the 1500 suspicious players (cheaters)
for i in range(SUSPICIOUS_PLAYERS_COUNT):
    players.append(Player(f"CHEATER_{i+1}", "cheater"))
# Register the remaining clean player base
clean_count = TOTAL_PLAYERS - SUSPICIOUS_PLAYERS_COUNT - PRO_PLAYERS_COUNT
for i in range(clean_count):
    players.append(Player(f"CLEAN_{i+1}", "clean"))

# Generate the 500 Patrol Judges
judges = [Judge(f"JUDGE_{i+1}") for i in range(JUDGES_COUNT)]

print(f"Registered Players: {len(players)} (Clean: {clean_count}, Cheaters: {SUSPICIOUS_PLAYERS_COUNT}, Pros: {PRO_PLAYERS_COUNT})")
print(f"Active Overwatch Judges: {len(judges)}")
print("-" * 70)


# ==========================================
# PHASE 1: ACTIVE DETECTION (HONEYPOTS)
# ==========================================
print("\n[PHASE 1] Deploying Geometric Honeypots (Invisible Entity Traps)...")
honeypot_triggers = 0
for p in players:
    if p.role == "cheater":
        # Simulate 35% of cheaters instantly snapping to invisible geometry
        if random.random() < 0.35:
            p.honeypot_triggered = True
            p.status = "Shadow_Flagged"  # Direct bypass to Shadow verification phase
            p.shadow_matches_left = 2
            honeypot_triggers += 1

print(f">> Honeypots provided mathematical proof of cheat software for {honeypot_triggers} players. Bypassing normal queue to Shadow Flag.")


# ==========================================
# PHASE 2: GENERATING THE OVERWATCH QUEUE
# ==========================================
patrol_queue = []
pro_queue = []

for p in players:
    if p.honeypot_triggered:
        continue  # Already processed by active detection
    
    if p.role == "cheater":
        patrol_queue.append(p)
    elif p.role == "pro":
        # Keep pro players separate for high-tier review
        pro_queue.append(p)
    elif p.role == "clean":
        # ~2% of clean players perform exceptionally well and receive random reports ("lucky shots")
        if random.random() < 0.02:
            p.lucky_shot_trigger = True
            patrol_queue.append(p)

print(f">> Overwatch Queue built. Suspicious cases pending evaluation: {len(patrol_queue)}")


# ==========================================
# PHASE 3: JUDGE AUDITING (TEST CASES)
# ==========================================
print("\n[PHASE 3] Executing Anti-Fraud Audits (Injecting Test Cases)...")
demoted_judges = 0
for j in judges:
    # Inject 5 calibration cases with pre-validated outcomes
    for _ in range(5):
        test_case = Player("TEST", "cheater" if random.random() > 0.5 else "clean")
        verdict = j.evaluate_case(test_case, is_test_case=True)
        correct_outcome = "Guilty" if test_case.role == "cheater" else "Innocent"
        
        if verdict == correct_outcome:
            j.test_cases_passed += 1
            j.rating += 5  # Minor rating increase for consistency
        else:
            j.test_cases_failed += 1
            j.rating -= 40  # Rapid Glicko-2 decay for incorrect verdicts

# Quarantine low-performing or lazy judges
for j in judges:
    if j.test_cases_failed >= 3:
        j.lazy_voter = True
        j.rating -= 100
        demoted_judges += 1

print(f">> Audit complete. Lazy or inaccurate judges restricted: {demoted_judges}")


# ==========================================
# PHASE 4: STANDARD CASE EVALUATION
# ==========================================
print("\n[PHASE 4] Distributing cases to Overwatch 2.0 Judges...")

for player in patrol_queue:
    # Select 20 to 30 independent judges
    num_judges = random.randint(20, 30)
    assigned_judges = random.sample(judges, num_judges)

    total_weight = 0
    guilty_weight = 0

    for judge in assigned_judges:
        # Ignore judges whose rating has decayed below the minimum trust threshold
        if judge.rating < 1100:
            continue
        
        verdict = judge.evaluate_case(player)
        weight = judge.vote_weight
        
        total_weight += weight
        if verdict == "Guilty":
            guilty_weight += weight

    # Calculate weighted consensus ratio
    guilty_ratio = (guilty_weight / total_weight) if total_weight > 0 else 0

    if guilty_ratio >= 0.65:  # Requires a 65% weighted consensus to flag
        player.status = "Shadow_Flagged"
        player.shadow_matches_left = 3  # Start 3-match monitoring window


# ==========================================
# PHASE 5: PRO-PLAYER SAFETY VALVE
# ==========================================
print("\n[PHASE 5] Processing Professional Player Escalations...")
# Filter and retrieve the top 30 judges based on Glicko-2 ratings
best_judges = sorted(judges, key=lambda x: x.rating, reverse=True)[:30]
average_best_rating = sum(j.rating for j in best_judges) / 30

print(f">> Assigned elite panel of 30 judges (Average Glicko-2: {average_best_rating:.1f})")

for pro in pro_queue:
    print(f"  * Case Review: {pro.id}")
    total_weight = 0
    guilty_weight = 0

    for judge in best_judges:
        verdict = judge.evaluate_case(pro)
        weight = judge.vote_weight
        total_weight += weight
        if verdict == "Guilty":
            guilty_weight += weight

    consensus = (guilty_weight / total_weight) if total_weight > 0 else 0
    print(f"    - Overwatch Consensus: {consensus*100:.1f}% voted Guilty (due to near-inhuman reflex patterns)")
    
    # Send case to Valve Employee manual verification to bypass false bans
    print(f"    - [SAFETY OVERRIDE] Escalated to Valve Employee Manual Review.")
    print(f"    - [Valve Verdict]: Player identity verified as white-listed pro. Account cleared. Status: Clean.")
    pro.status = "Active"


# ==========================================
# PHASE 6: SHADOW PERIOD VERIFICATION (2-3 MATCHES)
# ==========================================
print("\n[PHASE 6] Enforcing '2-3 Match Rule' Shadow Period...")

banned_cheaters = 0
false_positives = 0

for p in players:
    if p.status == "Shadow_Flagged":
        # Monitor player behavior over subsequent matches
        anomalies_detected_during_test = False
        
        for _ in range(p.shadow_matches_left):
            if p.role == "cheater":
                # Active cheaters cannot disable their software consistently and will trip telemetry again
                if random.random() > 0.15: # 85% chance of recurrence over 3 matches
                    anomalies_detected_during_test = True
            elif p.role == "clean":
                # Clean players naturally return to baseline performance metrics
                if random.random() < 0.01: # 1% statistical anomaly recurrence
                    anomalies_detected_during_test = True

        # Finalize verdict based on shadow telemetry + honeypot history
        if anomalies_detected_during_test or p.honeypot_triggered:
            p.status = "Banned"
            if p.role == "cheater":
                banned_cheaters += 1
            else:
                false_positives += 1
        else:
            # Telemetry returned to normal, flag safely removed
            p.status = "Active"


# ==========================================
# SIMULATION SUMMARY DASHBOARD
# ==========================================
print("\n" + "="*20 + " HYBRID SYSTEM PERFORMANCE DASHBOARD " + "="*20)
print(f"Total Player Base Simulated:       {TOTAL_PLAYERS}")
print(f"Actual Active Cheaters:            {SUSPICIOUS_PLAYERS_COUNT}")
print(f"Actual Professional Players:       {PRO_PLAYERS_COUNT}")
print("-" * 71)
detection_rate = (banned_cheaters / SUSPICIOUS_PLAYERS_COUNT) * 100
print(f"Successfully Banned Cheaters:      {banned_cheaters} / {SUSPICIOUS_PLAYERS_COUNT} ({detection_rate:.1f}%)")
print(f"False Positives (Clean Players):   {false_positives} (False Positive Rate: {false_positives/TOTAL_PLAYERS*100:.3f}%)")
print(f"False Positives (Pro Players):     0 / {PRO_PLAYERS_COUNT} (0% Error rate achieved via Valve safety valve)")
print("-" * 71)

# Display Judge Rank Distribution
trainees = len([j for j in judges if j.rank == "Trainee"])
full_judges = len([j for j in judges if j.rank == "Judge"])
senior_judges = len([j for j in judges if j.rank == "Senior Judge"])
print("Patrol System Glicko-2 Distribution:")
print(f" * Trainees (Vote Weight = 1):     {trainees} judges")
print(f" * Judges (Vote Weight = 3):       {full_judges} judges")
print(f" * Senior Judges (Vote Weight = 9):{senior_judges} judges")
print("="*77)
