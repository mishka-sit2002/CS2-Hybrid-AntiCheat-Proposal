import random

# --- SIMULATION CONFIGURATION ---
TOTAL_PLAYERS = 10000
SUSPICIOUS_PLAYERS_COUNT = 1500
PRO_PLAYERS_COUNT = 3
JUDGES_COUNT = 500

class Player:
    def __init__(self, player_id, role):
        self.id = player_id
        self.role = role  # Options: 'clean', 'cheater', 'pro'
        self.status = "Active"  # Options: 'Active', 'Shadow_Flagged', 'Banned'
        self.vac_live_flagged = False  # Track if VAC Live flags them as suspicious
        self.honeypot_deployed = False  # Track if a dynamic honeypot was requested
        self.honeypot_triggered = False  # Target snapped to invisible geometry
        self.shadow_matches_left = 0

class Judge:
    def __init__(self, judge_id):
        self.id = judge_id
        self.rating = random.randint(1300, 2100)  # Glicko-2 rating
        self.lazy_voter = random.random() < 0.05  # 5% probability of a low-effort spam voter
        self.test_cases_passed = 0
        self.test_cases_failed = 0

    @property
    def rank(self):
        if self.rating < 1600:
            return "Trainee"
        elif self.rating < 1950:
            return "Judge"
        else:
            return "Senior Judge"

    @property
    def vote_weight(self):
        if self.rank == "Trainee":
            return 1
        elif self.rank == "Judge":
            return 3
        else:
            return 9

    def evaluate_case(self, player, is_test_case=False):
        if self.lazy_voter:
            return random.choice(["Guilty", "Innocent"])

        # Base accuracy scales with Glicko-2 rating (ranging from 65% to 98%)
        accuracy = 0.70 + (self.rating - 1300) / 800 * 0.28
        accuracy = min(0.98, max(0.65, accuracy))

        roll = random.random()
        
        if player.role == "cheater":
            return "Guilty" if roll <= accuracy else "Innocent"
        elif player.role == "clean":
            return "Innocent" if roll <= accuracy else "Guilty"
        elif player.role == "pro":
            # High-tier pros display mechanics that standard judges may confuse with cheats
            pro_detection_accuracy = accuracy * 0.60
            return "Innocent" if roll <= pro_detection_accuracy else "Guilty"


# ==========================================
# SYSTEM INITIALIZATION
# ==========================================
print("[VAC Live + Overwatch 2.0] Initializing Simulation...")

players = []
# Register the 3 pro players
for i in range(PRO_PLAYERS_COUNT):
    players.append(Player(f"PRO_{i+1}", "pro"))
# Register the 1500 suspicious players (cheaters)
for i in range(SUSPICIOUS_PLAYERS_COUNT):
    players.append(Player(f"CHEATER_{i+1}", "cheater"))
# Register the remaining clean player base
clean_count = TOTAL_PLAYERS - SUSPICIOUS_PLAYERS_COUNT - PRO_PLAYERS_COUNT
for i in range(clean_count):
    players.append(Player(f"CLEAN_{i+1}", "clean"))

# Generate the 500 Patrol Judges
judges = [Judge(f"JUDGE_{i+1}") for i in range(JUDGES_COUNT)]

print(f"Registered Players: {len(players)} (Clean: {clean_count}, Cheaters: {SUSPICIOUS_PLAYERS_COUNT}, Pros: {PRO_PLAYERS_COUNT})")
print(f"Active Overwatch Judges: {len(judges)}")
print("-" * 75)


# ==========================================
# PHASE 1: VAC LIVE TELEMETRY MONITORING
# ==========================================
print("\n[PHASE 1] VAC Live Telemetry Scan (Monitoring matches in real-time)...")
vac_live_flags = 0

for p in players:
    if p.role == "cheater":
        # 85% of cheaters display anomalous camera movements or aiming telemetry
        if random.random() < 0.85:
            p.vac_live_flagged = True
            vac_live_flags += 1
    elif p.role == "pro":
        # 100% of pro players trigger telemetry warnings due to extreme flick speeds and accuracy
        p.vac_live_flagged = True
        vac_live_flags += 1
    elif p.role == "clean":
        # Only 2% of standard clean players trigger flags due to lucky shots
        if random.random() < 0.02:
            p.vac_live_flagged = True
            vac_live_flags += 1

print(f">> VAC Live flagged {vac_live_flags} suspicious players based on real-time telemetry anomalies.")


# ==========================================
# PHASE 2: ON-DEMAND HONEYPOT DEPLOYMENT
# ==========================================
print("\n[PHASE 2] Requesting Dynamic Honeypots (On-Demand Deployment for flagged players)...")
honeypots_deployed_count = 0
honeypots_triggered_count = 0

for p in players:
    if p.vac_live_flagged:
        # The game server dynamically spawns invisible hitboxes in nearby walls ONLY for this player
        p.honeypot_deployed = True
        honeypots_deployed_count += 1
        
        if p.role == "cheater":
            # Active wallhackers/aimlockers have a 50% chance of snapping to these newly spawned entities
            if random.random() < 0.50:
                p.honeypot_triggered = True
                p.status = "Shadow_Flagged"  # Bypasses standard queues to Shadow Phase with 100% proof
                p.shadow_matches_left = 2
                honeypots_triggered_count += 1
        else:
            # Clean players and Pros cannot see the entities inside solid geometry.
            # Thus, they have a 0% chance of triggering them, ensuring no false positives.
            p.honeypot_triggered = False

print(f">> Server spawned honeypot entities for {honeypots_deployed_count} flagged accounts.")
print(f">> Trap Results: {honeypots_triggered_count} cheaters snapped to invisible geometry (Deterministic Proof).")


# ==========================================
# PHASE 3: DISTRIBUTING UNRESOLVED CASES TO OVERWATCH
# ==========================================
print("\n[PHASE 3] Routing Unresolved Cases to Overwatch queues...")
patrol_queue = []
pro_queue = []

for p in players:
    if not p.vac_live_flagged:
        continue  # Player was completely normal
    
    if p.honeypot_triggered:
        continue  # Already caught with deterministic proof
    
    # If they were flagged but did not trip the honeypot, they go to standard manual review
    if p.role == "pro":
        pro_queue.append(p)
    else:
        patrol_queue.append(p)

print(f">> Standard Queue Cases (Flagged, did not trip honeypot): {len(patrol_queue)}")
print(f">> Pro-Player Safety Queue: {len(pro_queue)}")


# ==========================================
# PHASE 4: STANDARD CASE EVALUATION (CONCURRENT AUDITS)
# ==========================================
# Inject some calibration checks for judges to prevent lazy voting
for j in judges:
    for _ in range(5):
        test_case = Player("TEST", "cheater" if random.random() > 0.5 else "clean")
        verdict = j.evaluate_case(test_case)
        correct = "Guilty" if test_case.role == "cheater" else "Innocent"
        if verdict == correct:
            j.rating += 5
        else:
            j.rating -= 40

# Process Standard Queue
for player in patrol_queue:
    num_judges = random.randint(20, 30)
    assigned_judges = random.sample(judges, num_judges)

    total_weight = 0
    guilty_weight = 0

    for judge in assigned_judges:
        if judge.rating < 1100:
            continue
        verdict = judge.evaluate_case(player)
        weight = judge.vote_weight
        total_weight += weight
        if verdict == "Guilty":
            guilty_weight += weight

    guilty_ratio = (guilty_weight / total_weight) if total_weight > 0 else 0
    if guilty_ratio >= 0.65:
        player.status = "Shadow_Flagged"
        player.shadow_matches_left = 3


# ==========================================
# PHASE 5: ELITE REVIEW & VALVE SAFETY VALVE FOR PROS
# ==========================================
print("\n[PHASE 5] Executing Pro-Player Safety Valve...")
best_judges = sorted(judges, key=lambda x: x.rating, reverse=True)[:30]

for pro in pro_queue:
    print(f"  * Escalated Case: {pro.id}")
    total_weight = 0
    guilty_weight = 0

    for judge in best_judges:
        verdict = judge.evaluate_case(pro)
        weight = judge.vote_weight
        total_weight += weight
        if verdict == "Guilty":
            guilty_weight += weight

    consensus = (guilty_weight / total_weight) if total_weight > 0 else 0
    print(f"    - Elite Panel Vote: {consensus*100:.1f}% voted Guilty")
    print(f"    - [CRITICAL OVERRIDE] Sent to Valve Security Operations.")
    print(f"    - [Valve Verdict]: Verified as professional match performance. Status cleared.")
    pro.status = "Active"


# ==========================================
# PHASE 6: SHADOW PERIOD VERIFICATION (2-3 MATCHES)
# ==========================================
print("\n[PHASE 6] Verifying Shadow Flagged Accounts over 2-3 Matches...")

banned_cheaters = 0
false_positives = 0

for p in players:
    if p.status == "Shadow_Flagged":
        anomalies_detected = False
        
        # Monitor subsequent matches
        for _ in range(p.shadow_matches_left):
            if p.role == "cheater":
                if random.random() > 0.15:  # 85% chance they keep using the cheat
                    anomalies_detected = True
            elif p.role == "clean":
                if random.random() < 0.01:  # 1% chance of repeating a highly suspicious anomaly
                    anomalies_detected = True

        if anomalies_detected or p.honeypot_triggered:
            p.status = "Banned"
            if p.role == "cheater":
                banned_cheaters += 1
            else:
                false_positives += 1
        else:
            p.status = "Active"


# ==========================================
# SIMULATION SUMMARY DASHBOARD
# ==========================================
print("\n" + "="*20 + " HYBRID SYSTEM PERFORMANCE DASHBOARD " + "="*20)
print(f"Total Player Base Simulated:       {TOTAL_PLAYERS}")
print(f"Actual Active Cheaters:            {SUSPICIOUS_PLAYERS_COUNT}")
print(f"Actual Professional Players:       {PRO_PLAYERS_COUNT}")
print("-" * 75)
detection_rate = (banned_cheaters / SUSPICIOUS_PLAYERS_COUNT) * 100
print(f"Successfully Banned Cheaters:      {banned_cheaters} / {SUSPICIOUS_PLAYERS_COUNT} ({detection_rate:.1f}%)")
print(f" * Caught via dynamic honeypots:   {honeypots_triggered_count}")
print(f" * Caught via Overwatch consensus:  {banned_cheaters - honeypots_triggered_count}")
print("-" * 75)
print(f"False Positives (Clean Players):   {false_positives} (False Positive Rate: {false_positives/TOTAL_PLAYERS*100:.3f}%)")
print(f"False Positives (Pro Players):     0 / {PRO_PLAYERS_COUNT} (0% Error rate achieved via Valve safety valve)")
print("="*77)
