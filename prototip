class OverwatchAPI:
    """REST-like API interface for the anti-cheat system."""

    def __init__(self, engine: AntiCheatEngine):
        self.engine = engine

    def report_player(self, suspect_id: str, reporter_id: str, 
                      evidence_clips: List[Dict]) -> Dict:
        """Submit a player report with evidence."""
        case = self.engine.create_case(
            suspect_id,
            [reporter_id],
            evidence_clips
        )
        return {
            "case_id": case.case_id,
            "status": "submitted",
            "estimated_judges": "20-30",
            "anonymized_id": case.anonymized_id
        }

    def submit_verdict(self, judge_id: str, case_id: str, 
                       verdict: str, time_spent: float) -> Dict:
        """Submit a judge verdict."""
        judge = self.engine.judges.get(judge_id)
        case = self.engine.cases.get(case_id)

        if not judge or not case:
            return {"error": "Invalid judge or case ID"}

        try:
            verdict_enum = Verdict(verdict)
            case.add_verdict(judge, verdict_enum, time_spent)

            # Check if consensus reached
            consensus = case.calculate_consensus()
            if consensus:
                case.finalize_verdict(consensus)
                return {
                    "status": "consensus_reached",
                    "verdict": consensus.value,
                    "case_status": case.status.value
                }

            return {
                "status": "verdict_recorded",
                "judges_so_far": len(case.verdicts),
                "consensus": "pending"
            }

        except ValueError as e:
            return {"error": str(e)}

    def get_case_status(self, case_id: str) -> Dict:
        """Get current case status."""
        case = self.engine.cases.get(case_id)
        if not case:
            return {"error": "Case not found"}

        return {
            "case_id": case_id,
            "status": case.status.value,
            "verdicts_count": len(case.verdicts),
            "shadow_matches_remaining": case.shadow_matches_remaining,
            "final_verdict": case.final_verdict.value if case.final_verdict else None
        }

    def get_judge_profile(self, judge_id: str) -> Dict:
        """Get judge statistics."""
        judge = self.engine.judges.get(judge_id)
        if not judge:
            return {"error": "Judge not found"}

        return {
            "judge_id": judge_id,
            "tier": judge.tier.value,
            "rating": round(judge.rating, 2),
            "rd": round(judge.rd, 2),
            "vote_weight": round(judge.vote_weight, 2),
            "cases_reviewed": judge.cases_reviewed,
            "accuracy": round(judge.accuracy * 100, 2),
            "badge": judge.badge.value,
            "is_active": judge.is_active
        }

