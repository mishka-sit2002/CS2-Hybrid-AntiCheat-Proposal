class AntiCheatEngine:
    def __init__(self):
        self.players: Dict[str, Player] = {}
        self.judges: Dict[str, Judge] = {}
        self.cases: Dict[str, Case] = {}
        self.ml_patterns: List[Dict] = []  # Known cheat signatures
        self.honeypot_cases_injected: int = 0

    def register_player(self, steam_id: str, nickname: str, wins: int, hours: int, rank: str):
        self.players[steam_id] = Player(steam_id, nickname, wins, hours, rank)

    def register_judge(self, steam_id: str, nickname: str, wins: int, hours: int, rank: str) -> Judge:
        judge = Judge(steam_id, nickname, wins, hours, rank)
        self.judges[steam_id] = judge
        return judge

    def create_case(self, suspect_id: str, reporter_ids: List[str], 
                    fragments_data: List[Dict], is_honeypot_case: bool = False) -> Case:
        """Create a new case with evidence fragments."""
        case_id = f"CASE-{hashlib.sha256(str(time.time()).encode()).hexdigest()[:12].upper()}"

        fragments = []
        for i, data in enumerate(fragments_data):
            frag = EvidenceFragment(
                fragment_id=f"{case_id}-FRAG-{i}",
                timestamp=time.time(),
                duration=data.get("duration", 15),
                telemetry_data=data.get("telemetry", {}),
                is_honeypot=data.get("is_honeypot", False),
                honeypot_type=data.get("honeypot_type")
            )
            fragments.append(frag)

        case = Case(case_id, suspect_id, reporter_ids, fragments)
        self.cases[case_id] = case

        if is_honeypot_case:
            self.honeypot_cases_injected += 1
            print(f"🍯 Honeypot case injected: {case_id}")

        return case

    def assign_judges(self, case: Case, count: int = 25) -> List[Judge]:
        """Assign random active judges to a case."""
        active_judges = [j for j in self.judges.values() if j.is_active]
        if len(active_judges) < count:
            count = len(active_judges)
        return random.sample(active_judges, count)

    def simulate_verdicts(self, case: Case, judges: List[Judge], 
                          actual_cheating: bool = False):
        """Simulate judges reviewing a case."""
        for judge in judges:
            # Simulate review time (some judges are lazy)
            time_spent = random.gauss(180, 60)  # Mean 3 minutes
            if random.random() < 0.05:  # 5% lazy judges
                time_spent = random.randint(30, 80)

            time_spent = max(30, time_spent)

            # Judge accuracy based on rating
            accuracy = 0.5 + (judge.rating - 1000) / 4000  # 0.5 to ~1.0
            accuracy = max(0.6, min(0.98, accuracy))

            # Determine verdict
            if random.random() < accuracy:
                verdict = Verdict.GUILTY if actual_cheating else Verdict.NOT_GUILTY
            else:
                verdict = Verdict.NOT_GUILTY if actual_cheating else Verdict.GUILTY

            # 10% chance to flag new pattern (only for good judges on actual cheats)
            if actual_cheating and judge.rating > 1800 and random.random() < 0.1:
                verdict = Verdict.NEW_PATTERN
                judge.new_patterns_found += 1

            try:
                case.add_verdict(judge, verdict, time_spent)

                # Update judge accuracy (ground truth known for simulation)
                if verdict in [Verdict.GUILTY, Verdict.NOT_GUILTY]:
                    was_correct = (verdict == Verdict.GUILTY) == actual_cheating
                    judge.update_accuracy(was_correct)

            except ValueError as e:
                continue

    def process_case(self, case_id: str) -> Dict:
        """Process a case through the full pipeline."""
        case = self.cases[case_id]
        suspect = self.players.get(case.suspect_id)

        # Step 1: VAC Live - Check honeypot triggers (deterministic)
        honeypot_triggers = sum(1 for f in case.fragments if f.analyze_honeypot_trigger())

        # Step 2: Assign judges
        judges = self.assign_judges(case, count=random.randint(20, 30))

        # Step 3: Simulate verdicts (in production, judges actually review)
        # Determine if suspect is actually cheating (for simulation)
        actual_cheating = honeypot_triggers > 0 or random.random() < 0.3
        self.simulate_verdicts(case, judges, actual_cheating)

        # Step 4: Check consensus
        consensus = case.calculate_consensus()

        # Step 5: Honeypot case check — always evaluate regardless of consensus
        is_honeypot_case = any(f.is_honeypot for f in case.fragments)
        if is_honeypot_case:
            expected = Verdict.GUILTY  # Honeypot cases are always guilty
            for judge_id, verdict, _, _ in case.verdicts:
                judge = self.judges[judge_id]
                if verdict != expected:
                    judge.apply_honeypot_penalty()

        result = {
            "case_id": case_id,
            "suspect": case.suspect_id[:8] + "...",
            "honeypot_triggers": honeypot_triggers,
            "judges_assigned": len(judges),
            "consensus": consensus.value if consensus else "pending",
            "status": case.status.value,
            "actual_cheating": actual_cheating
        }

        if consensus:
            case.finalize_verdict(consensus)
            result["status"] = case.status.value

            if consensus == Verdict.GUILTY and suspect:
                # Shadow flag instead of immediate ban
                case.shadow_verdict = Verdict.GUILTY
                case.shadow_matches_remaining = random.randint(2, 3)
                print(f"⚡ Case {case_id}: GUILTY verdict. Shadow monitoring activated ({case.shadow_matches_remaining} matches).")
            elif consensus == Verdict.NOT_GUILTY:
                print(f"✅ Case {case_id}: NOT GUILTY. Suspect acquitted.")

        return result

    def shadow_monitoring_tick(self, case_id: str, match_telemetry: Dict) -> Dict:
        """Process one match during shadow monitoring phase."""
        case = self.cases[case_id]

        if case.status != CaseStatus.SHADOW_FLAGGED or case.shadow_matches_remaining <= 0:
            return {"error": "Case not in shadow monitoring"}

        case.shadow_matches_remaining -= 1

        # Check if suspicious patterns persist
        aim_anomalies = match_telemetry.get("aim_anomalies", 0)
        wall_traces = match_telemetry.get("wall_traces", 0)

        # Human norms: < 3 aim anomalies, < 5 wall traces per match
        is_still_suspicious = aim_anomalies > 3 or wall_traces > 5

        result = {
            "case_id": case_id,
            "matches_remaining": case.shadow_matches_remaining,
            "aim_anomalies": aim_anomalies,
            "wall_traces": wall_traces,
            "still_suspicious": is_still_suspicious
        }

        if case.shadow_matches_remaining == 0:
            if is_still_suspicious:
                # Finalize ban
                case.status = CaseStatus.BANNED
                suspect = self.players.get(case.suspect_id)
                if suspect:
                    suspect.is_banned = True
                    suspect.ban_reason = "Overwatch 2.0 - Consensus Guilty + Shadow Monitoring Confirmed"
                result["final_action"] = "BANNED"
                print(f"🔨 BAN FINALIZED: {case_id} — Shadow monitoring confirmed cheating patterns.")
            else:
                # Return to human norms, remove flag
                case.status = CaseStatus.ACQUITTED
                result["final_action"] = "FLAG_REMOVED"
                print(f"🛡️ FLAG REMOVED: {case_id} — Performance returned to human norms.")
        else:
            result["final_action"] = "CONTINUE_MONITORING"

        return result

    def cleanup_expired_data(self):
        """Delete raw video data 7 days post-verdict."""
        now = datetime.now()
        cleaned = 0
        for case in self.cases.values():
            if case.data_deletion_scheduled and case.data_deletion_scheduled <= now:
                # In real system: delete video files
                case.fragments = []  # Clear fragments
                cleaned += 1
        return cleaned

    def get_system_stats(self) -> Dict:
        """Get overall system statistics."""
        total_cases = len(self.cases)
        banned = sum(1 for c in self.cases.values() if c.status == CaseStatus.BANNED)
        acquitted = sum(1 for c in self.cases.values() if c.status == CaseStatus.ACQUITTED)
        pending = sum(1 for c in self.cases.values() if c.status == CaseStatus.PENDING)
        shadow = sum(1 for c in self.cases.values() if c.status == CaseStatus.SHADOW_FLAGGED)

        judge_stats = {
            "total": len(self.judges),
            "active": sum(1 for j in self.judges.values() if j.is_active),
            "avg_rating": sum(j.rating for j in self.judges.values()) / max(1, len(self.judges)),
            "avg_accuracy": sum(j.accuracy for j in self.judges.values()) / max(1, len(self.judges)),
            "platinum_badges": sum(1 for j in self.judges.values() if j.badge == BadgeLevel.PLATINUM)
        }

        return {
            "cases": {
                "total": total_cases,
                "banned": banned,
                "acquitted": acquitted,
                "pending": pending,
                "shadow_flagged": shadow,
                "ban_rate": banned / max(1, total_cases)
            },
            "judges": judge_stats,
            "honeypot_cases_injected": self.honeypot_cases_injected,
            "ml_patterns_known": len(self.ml_patterns)
        }

