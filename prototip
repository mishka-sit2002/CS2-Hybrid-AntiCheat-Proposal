class JudgeTier(Enum):
    TRAINEE = "trainee"
    JUDGE = "judge"
    SENIOR = "senior"

class Verdict(Enum):
    GUILTY = "guilty"
    NOT_GUILTY = "not_guilty"
    TOO_COMPLEX = "too_complex"
    NEW_PATTERN = "new_pattern"

class CaseStatus(Enum):
    PENDING = "pending"
    SHADOW_FLAGGED = "shadow_flagged"
    BANNED = "banned"
    ACQUITTED = "acquitted"
    UNDER_REVIEW = "under_review"

class BadgeLevel(Enum):
    NONE = "none"
    BRONZE = "bronze"
    SILVER = "silver"
    GOLD = "gold"
    PLATINUM = "platinum"

@dataclass
class Player:
    steam_id: str
    nickname: str = field(repr=False)
    total_wins: int = 0
    total_hours: int = 0
    rank: str = "Unranked"
    is_banned: bool = False
    ban_reason: Optional[str] = None
    shadow_flags: List[Dict] = field(default_factory=list)

    def meets_requirements(self, wins: int, hours: int, min_rank: str) -> bool:
        """Check if player meets judge requirements."""
        rank_order = ["Silver", "Gold Nova 1", "Gold Nova 3", "MG1", "MG2", "DMG", "LE", "LEM", "SMFC", "GE"]
        try:
            rank_idx = rank_order.index(self.rank) if self.rank in rank_order else -1
            min_idx = rank_order.index(min_rank) if min_rank in rank_order else -1
        except ValueError:
            return False
        return self.total_wins >= wins and self.total_hours >= hours and rank_idx >= min_idx

@dataclass
class Judge:
    steam_id: str
    nickname: str = field(repr=False)
    total_wins: int
    total_hours: int
    rank: str

    # Glicko-2 Rating System
    rating: float = 1500.0
    rd: float = 350.0  # Rating deviation
    sigma: float = 0.06  # Volatility

    # Stats
    cases_reviewed: int = 0
    accuracy: float = 0.0
    correct_verdicts: int = 0
    honeypot_fails: int = 0
    lazy_votes: int = 0
    new_patterns_found: int = 0

    # Status
    is_active: bool = True
    temp_ban_until: Optional[datetime] = None
    badge: BadgeLevel = BadgeLevel.NONE

    @property
    def tier(self) -> JudgeTier:
        if self.meets_requirements(1000, 2000, "DMG") and self.rating >= 2000:
            return JudgeTier.SENIOR
        elif self.meets_requirements(500, 1000, "MG1"):
            return JudgeTier.JUDGE
        elif self.meets_requirements(250, 600, "Gold Nova 3"):
            return JudgeTier.TRAINEE
        return JudgeTier.TRAINEE

    @property
    def vote_weight(self) -> float:
        """Calculate vote weight based on Glicko-2 rating."""
        base_weights = {
            JudgeTier.TRAINEE: 1.0,
            JudgeTier.JUDGE: 3.0,
            JudgeTier.SENIOR: 9.0
        }
        tier_weight = base_weights.get(self.tier, 1.0)
        # Rating modifier: ±20% based on rating deviation from 1500
        rating_modifier = 1.0 + ((self.rating - 1500) / 5000)
        return max(0.5, tier_weight * rating_modifier)

    def meets_requirements(self, wins: int, hours: int, min_rank: str) -> bool:
        rank_order = ["Silver", "Gold Nova 1", "Gold Nova 3", "MG1", "MG2", "DMG", "LE", "LEM", "SMFC", "GE"]
        try:
            rank_idx = rank_order.index(self.rank) if self.rank in rank_order else -1
            min_idx = rank_order.index(min_rank) if min_rank in rank_order else -1
        except ValueError:
            return False
        return self.total_wins >= wins and self.total_hours >= hours and rank_idx >= min_idx

    def update_accuracy(self, was_correct: bool):
        self.cases_reviewed += 1
        if was_correct:
            self.correct_verdicts += 1
        self.accuracy = self.correct_verdicts / max(1, self.cases_reviewed)
        self._update_badge()

    def _update_badge(self):
        if self.accuracy >= 0.95 and self.cases_reviewed >= 500:
            self.badge = BadgeLevel.PLATINUM
        elif self.accuracy >= 0.90 and self.cases_reviewed >= 300:
            self.badge = BadgeLevel.GOLD
        elif self.accuracy >= 0.85 and self.cases_reviewed >= 100:
            self.badge = BadgeLevel.SILVER
        elif self.accuracy >= 0.80 and self.cases_reviewed >= 50:
            self.badge = BadgeLevel.BRONZE

    def apply_lazy_penalty(self):
        self.lazy_votes += 1
        if self.lazy_votes >= 3:
            self.temp_ban_until = datetime.now() + timedelta(days=7)
            self.is_active = False
            print(f"⚠️  Judge {self.steam_id[:8]}... temporarily banned for lazy voting.")

    def apply_honeypot_penalty(self):
        self.honeypot_fails += 1
        self.rating -= 100  # Glicko-2 decay
        self.rd = min(350, self.rd + 50)
        if self.honeypot_fails >= 3:
            self.is_active = False
            print(f"🚫 Judge {self.steam_id[:8]}... permanently removed for honeypot failures.")

@dataclass
class EvidenceFragment:
    fragment_id: str
    timestamp: float
    duration: int  # seconds
    telemetry_data: Dict
    is_honeypot: bool = False
    honeypot_type: Optional[str] = None  # "aimlock", "wallhack"

    def analyze_honeypot_trigger(self) -> bool:
        """Deterministic detection: did crosshair snap to invisible entity?"""
        if not self.is_honeypot:
            return False

        aim_data = self.telemetry_data.get("aim_snap_events", [])
        wall_data = self.telemetry_data.get("wall_trace_events", [])

        if self.honeypot_type == "aimlock":
            # Mathematical proof: crosshair snapped to invisible hitbox
            return len(aim_data) > 0 and any(e["target_invisible"] for e in aim_data)

        elif self.honeypot_type == "wallhack":
            # Mathematical proof: player tracked entity through solid geometry
            return len(wall_data) > 0 and any(e["through_wall"] for e in wall_data)

        return False

@dataclass
class Case:
    case_id: str
    suspect_id: str
    reported_by: List[str]
    fragments: List[EvidenceFragment]
    status: CaseStatus = CaseStatus.PENDING

    # Anonymization
    anonymized_id: str = field(default_factory=lambda: hashlib.sha256(str(uuid.uuid4()).encode()).hexdigest()[:16])

    # Verdicts
    verdicts: List[Tuple[str, Verdict, float, float]] = field(default_factory=list)  # (judge_id, verdict, weight, time_spent)

    # Shadow monitoring
    shadow_verdict: Optional[Verdict] = None
    shadow_matches_remaining: int = 0

    # Metadata
    created_at: datetime = field(default_factory=datetime.now)
    resolved_at: Optional[datetime] = None
    final_verdict: Optional[Verdict] = None

    # Data retention
    data_deletion_scheduled: Optional[datetime] = None

    def add_verdict(self, judge: Judge, verdict: Verdict, time_spent: float):
        if not judge.is_active:
            raise ValueError("Judge is not active")
        if judge.temp_ban_until and judge.temp_ban_until > datetime.now():
            raise ValueError("Judge is temporarily banned")

        # Lazy voting detection (< 90 seconds)
        if time_spent < 90:
            judge.apply_lazy_penalty()
            if not judge.is_active:
                return

        weight = judge.vote_weight
        self.verdicts.append((judge.steam_id, verdict, weight, time_spent))

    def calculate_consensus(self, min_judges: int = 20, max_judges: int = 30) -> Optional[Verdict]:
        if len(self.verdicts) < min_judges:
            return None

        weighted_guilty = sum(v[2] for v in self.verdicts if v[1] == Verdict.GUILTY)
        weighted_not_guilty = sum(v[2] for v in self.verdicts if v[1] == Verdict.NOT_GUILTY)
        weighted_too_complex = sum(v[2] for v in self.verdicts if v[1] == Verdict.TOO_COMPLEX)
        total_weight = weighted_guilty + weighted_not_guilty + weighted_too_complex

        if total_weight == 0:
            return None

        guilty_ratio = weighted_guilty / total_weight
        not_guilty_ratio = weighted_not_guilty / total_weight

        # Require 75% weighted consensus
        if guilty_ratio >= 0.75:
            return Verdict.GUILTY
        elif not_guilty_ratio >= 0.75:
            return Verdict.NOT_GUILTY
        elif len(self.verdicts) >= max_judges:
            # Max judges reached, case too complex
            return Verdict.TOO_COMPLEX

        return None

    def finalize_verdict(self, verdict: Verdict):
        self.final_verdict = verdict
        self.resolved_at = datetime.now()
        self.data_deletion_scheduled = self.resolved_at + timedelta(days=7)

        if verdict == Verdict.GUILTY:
            self.status = CaseStatus.SHADOW_FLAGGED
            self.shadow_matches_remaining = random.randint(2, 3)
        else:
            self.status = CaseStatus.ACQUITTED

